# Copy to .env (gitignored) on the server.

PAPERCLIP_IMAGE_TAG=2026.1005.0

# Public hostname that points at this VM, e.g. my-paperclip.duckdns.org
PAPERCLIP_DOMAIN=

# Generate each with: openssl rand -hex 32
BETTER_AUTH_SECRET=
PAPERCLIP_AGENT_JWT_SECRET=

# Optional provider keys (or add them later in the Secrets UI).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Only with docker-compose.external-db.yml (Neon / Supabase pooled URL).
DATABASE_URL=
